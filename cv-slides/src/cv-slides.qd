.docname {Maksim Zinovev — Career Deck}
.doctype {slides}
.doclang {English}
.theme {darko} layout:{minimal}

.css
    /* Career-path gantt readability: full-width chart, larger and brighter
       year axis, high-contrast task labels (mermaid defaults are ~#d3d3d3 on
       20%-opacity gray bands, and d3 hard-codes 10px axis ticks). */
    .quarkdown.quarkdown-slides figure .mermaid > svg {
        width: 100% !important;
        max-height: none !important; /* global.css caps at 50vh (0,3,1 specificity), which shrinks this wide gantt to ~1/3 of the slide */
    }
    .mermaid .taskTextOutsideLeft,
    .mermaid .taskTextOutsideRight {
        fill: #f5f5f5 !important;
        font-weight: 500;
    }
    .mermaid .grid .tick text {
        font-size: 20px !important;
        fill: #e6e6e6 !important;
        font-weight: 500;
    }
    /* Career-path gantt readability (text + scale only — bar fill is overridden
       via Mermaid themeCSS in the %%{init}%% directive because CSS in the page
       <head> cannot reach SVG rect fills in this rendering pipeline). */
    /* Toolkit snapshot icons: inline tech logos at the top of each toolkit box. */
    .quarkdown.quarkdown-slides .box img {
        height: 36px;
        width: auto;
        margin: 0 12px 8px 0;
        vertical-align: middle;
    }
    /* Closing-slide signature card: soft card look on the dark theme. Scoped by
       the unique filename so the mermaid figure and .box icon imgs are untouched.
       Original size preserved (max-width is an inert overflow clamp at the
       card's 400px natural width). */
    .quarkdown.quarkdown-slides img[src*="email-signature"] {
        border-radius: 10px;
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35);
        max-width: 100%;
        height: auto;
    }

.function {stat}
    value label:
    .column
        ## .value
        .label

# Maksim Zinovev

